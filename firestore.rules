rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- Helper Functions ----------------
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isTutorLinked(tutorId) {
      return exists(/databases/$(database)/documents/tutors/$(tutorId)) &&
             get(/databases/$(database)/documents/tutors/$(tutorId)).data.authUid == request.auth.uid;
    }
    function isChatParticipant(participants) {
      return request.auth.uid in participants ||
             (participants.size() > 0 && isTutorLinked(participants[0])) ||
             (participants.size() > 1 && isTutorLinked(participants[1]));
    }

    // ---------------- ADMINS ----------------
    match /admins/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow write: if isAdmin();
    }

    // ---------------- USERS ----------------
    match /users/{userId} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read, update: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin());
    }

    // ---------------- USERNAME CLAIMS ----------------
    match /usernameClaims/{username} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        resource.data.uid == request.auth.uid;
    }

    // ---------------- TUTORS ----------------
    match /tutors/{tutorId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (request.auth.uid == resource.data.authUid || isAdmin());
      allow create, delete: if isAdmin();
    }

    // ---------------- SESSIONS ----------------
    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.tutorId &&
        request.resource.data.status == "completed";
      allow update: if isAuthenticated() &&
        request.resource.data.status == "cancelled" &&
        resource.data.status != "completed" &&
        request.auth.uid in [resource.data.studentId, resource.data.tutorId];
      allow update: if isAuthenticated() &&
        request.resource.data.status == "pending_payment_verification" &&
        request.resource.data.studentId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        request.auth.uid in [resource.data.studentId, resource.data.tutorId] &&
        resource.data.status == "cancelled" &&
        (
          resource.data.refundDone == true ||
          resource.data.refund_done == true ||
          resource.data.refundStatus == "refunded" ||
          resource.data.refund_status == "refunded" ||
          resource.data.refundedAt != null ||
          resource.data.refunded_at != null
        );
      allow update, delete: if isAdmin();
    }

    // ---------------- PAYMENTS ----------------
    match /payments/{paymentId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.studentId || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ---------------- NOTIFICATIONS ----------------
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ---------------- CATEGORIES ----------------
    match /categories/{doc} {
      allow read: if true;
    }

    // ---------------- SUBJECTS ----------------
    match /subjects/{doc} {
      allow read: if true;
    }
    
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.id == request.resource.data.sessionId
        && request.resource.data.sessionId is string
        && request.resource.data.tutorId is string
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.reviewText is string
        && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.studentId == request.auth.uid
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.tutorId == request.resource.data.tutorId
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'completed'
        && !exists(/databases/$(database)/documents/reviews/$(request.resource.data.sessionId));

      allow update, delete: if false;
    }

    // ---------------- CHATS & MESSAGES ----------------
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if isAuthenticated() && (
          request.resource.data.senderId == request.auth.uid ||
          isTutorLinked(request.resource.data.senderId)
        ) && (
          chatId.matches('^' + request.resource.data.senderId + '_.*') ||
          chatId.matches('.*_' + request.resource.data.senderId + '$')
        );
        allow update, delete: if false;
      }
    }
  }
}